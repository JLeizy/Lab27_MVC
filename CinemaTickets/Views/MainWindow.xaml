<!--
    VIEW — то, что видит пользователь (как форма из методички, только больше).

    Здесь только разметка: где какие поля, кнопки и таблицы.
    Никаких расчётов и проверок. При нажатии кнопок вызываются обработчики
    в MainWindow.xaml.cs, а они сразу передают действие контроллеру.

    Строение окна:
      слева  — "Оформление билета": фильм, сеанс, ряд, место, тип билета, цена, кнопки;
      справа — "Схема зала" (места рисуются из кода по данным модели)
               и "Проданные билеты" (таблица + выручка + кнопка возврата);
      внизу  — строка статуса с последним сообщением.
-->
<Window x:Class="CinemaTickets.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Кинотеатр — продажа билетов (MVC)"
        Height="680" Width="1120" MinHeight="600" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        FontSize="13">

    <Window.Resources>
        <!-- Цвета мест. Заданы один раз здесь и используются и в легенде (ниже),
             и в коде, который рисует схему зала (через FindResource). -->
        <SolidColorBrush x:Key="FreeSeatBrush" Color="#FFC8E6C9"/>   <!-- свободно: зелёный -->
        <SolidColorBrush x:Key="VipSeatBrush" Color="#FFFFE082"/>    <!-- VIP-ряд: жёлтый -->
        <SolidColorBrush x:Key="TakenSeatBrush" Color="#FFE57373"/>  <!-- продано: красный -->
        <SolidColorBrush x:Key="ChosenSeatBrush" Color="#FF42A5F5"/> <!-- выбрано: синий -->

        <!-- Подписи над полями ввода. -->
        <Style x:Key="CaptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,10,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Обычные кнопки формы. -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,8,0,0"/>
        </Style>

        <!-- Кнопка-место на схеме зала: маленький прямоугольник с номером.
             Свой шаблон (Template) нужен, чтобы занятое место (IsEnabled=False)
             оставалось красным, а не становилось стандартным серым. -->
        <Style x:Key="SeatButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="#FF9E9E9E"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SeatBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="5,5,2,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!-- Подсветка рамки при наведении мыши. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SeatBorder" Property="BorderBrush" Value="#FF1565C0"/>
                                <Setter TargetName="SeatBorder" Property="BorderThickness" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Квадратик в легенде под схемой зала. -->
        <Style x:Key="LegendBoxStyle" TargetType="Border">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="14"/>
            <Setter Property="Margin" Value="12,0,4,0"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="BorderBrush" Value="#FF9E9E9E"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="330"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===================== ЛЕВАЯ ЧАСТЬ: ВВОД ===================== -->
        <GroupBox Grid.Column="0" Header="Оформление билета" Padding="10,4,10,10">
            <StackPanel>
                <TextBlock Text="Фильм" Style="{StaticResource CaptionStyle}"/>
                <ComboBox x:Name="MovieComboBox" Padding="6,4"
                          SelectionChanged="MovieComboBox_SelectionChanged"/>

                <TextBlock Text="Сеанс" Style="{StaticResource CaptionStyle}"/>
                <ComboBox x:Name="SessionComboBox" Padding="6,4"
                          SelectionChanged="SessionComboBox_SelectionChanged"/>

                <!-- Ряд и место в две колонки. -->
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Ряд" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="RowTextBox" Padding="4"
                                 TextChanged="OrderInput_TextChanged"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Место" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="SeatTextBox" Padding="4"
                                 TextChanged="OrderInput_TextChanged"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="HallHintTextBlock" Margin="0,4,0,0"
                           Foreground="Gray" FontSize="11" TextWrapping="Wrap"/>

                <TextBlock Text="Тип билета" Style="{StaticResource CaptionStyle}"/>
                <ComboBox x:Name="CategoryComboBox" Padding="6,4"
                          SelectionChanged="CategoryComboBox_SelectionChanged"/>

                <Button x:Name="CalculateButton" Content="Рассчитать стоимость"
                        Margin="0,16,0,0" Click="CalculateButton_Click"/>

                <!-- Результат расчёта (аналог ResultTextBlock из методички). -->
                <Border Margin="0,10,0,0" Padding="12,8" CornerRadius="4"
                        Background="#FFF5F5F5" BorderBrush="#FFD0D0D0" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Стоимость билета" Foreground="Gray"/>
                        <TextBlock x:Name="PriceTextBlock" Text="—"
                                   FontSize="28" FontWeight="Bold"/>
                    </StackPanel>
                </Border>

                <Button x:Name="SellButton" Content="Продать билет"
                        FontWeight="Bold" Padding="10,9"
                        Background="#FFA5D6A7"
                        Click="SellButton_Click"/>
            </StackPanel>
        </GroupBox>

        <!-- ===================== ПРАВАЯ ЧАСТЬ: ВЫВОД ===================== -->
        <Grid Grid.Column="1" Margin="10,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Схема зала. Заголовок и места заполняются в коде (DrawSeatMap). -->
            <GroupBox x:Name="HallGroupBox" Grid.Row="0" Header="Схема зала" Padding="8">
                <StackPanel HorizontalAlignment="Center">
                    <Border Background="#FF616161" CornerRadius="3" Height="20" Margin="60,2,10,10">
                        <TextBlock Text="Э К Р А Н" Foreground="White" FontSize="11"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <!-- Сюда код окна добавляет ряды с кнопками-местами. -->
                    <StackPanel x:Name="SeatMapPanel"/>

                    <!-- Легенда: что означает каждый цвет. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                        <Border Style="{StaticResource LegendBoxStyle}" Background="{StaticResource FreeSeatBrush}"/>
                        <TextBlock Text="свободно" FontSize="11"/>
                        <Border Style="{StaticResource LegendBoxStyle}" Background="{StaticResource VipSeatBrush}"/>
                        <TextBlock Text="VIP-ряд (цена ×1,5)" FontSize="11"/>
                        <Border Style="{StaticResource LegendBoxStyle}" Background="{StaticResource TakenSeatBrush}"/>
                        <TextBlock Text="продано" FontSize="11"/>
                        <Border Style="{StaticResource LegendBoxStyle}" Background="{StaticResource ChosenSeatBrush}"/>
                        <TextBlock Text="выбрано" FontSize="11"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <!-- Проданные билеты. -->
            <GroupBox Grid.Row="1" Header="Проданные билеты" Padding="8" Margin="0,8,0,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <Button x:Name="ReturnButton" DockPanel.Dock="Right" Margin="0"
                                Content="Вернуть выбранный билет" Click="ReturnButton_Click"/>
                        <TextBlock x:Name="TotalsTextBlock" VerticalAlignment="Center"
                                   FontWeight="SemiBold"/>
                    </DockPanel>

                    <!-- Таблица. Каждая колонка показывает одно свойство билета (Binding). -->
                    <ListView x:Name="TicketsListView" SelectionMode="Single">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="№" Width="40" DisplayMemberBinding="{Binding Number}"/>
                                <GridViewColumn Header="Фильм" Width="120" DisplayMemberBinding="{Binding Session.Movie.Title}"/>
                                <GridViewColumn Header="Сеанс" Width="60" DisplayMemberBinding="{Binding Session.StartTimeText}"/>
                                <GridViewColumn Header="Зал" Width="60" DisplayMemberBinding="{Binding Session.Hall.Name}"/>
                                <GridViewColumn Header="Ряд" Width="45" DisplayMemberBinding="{Binding Row}"/>
                                <GridViewColumn Header="Место" Width="55" DisplayMemberBinding="{Binding Seat}"/>
                                <GridViewColumn Header="Тип билета" Width="150" DisplayMemberBinding="{Binding Category.Name}"/>
                                <GridViewColumn Header="Цена, руб." Width="80" DisplayMemberBinding="{Binding Price, StringFormat={}{0:0}}"/>
                                <GridViewColumn Header="Продан в" Width="80" DisplayMemberBinding="{Binding SoldAt, StringFormat={}{0:HH:mm:ss}}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>
            </GroupBox>
        </Grid>

        <!-- ===================== СТРОКА СТАТУСА ===================== -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Margin="0,8,0,0" Padding="8,5"
                Background="#FFF5F5F5" BorderBrush="#FFD0D0D0" BorderThickness="1" CornerRadius="3">
            <TextBlock x:Name="StatusTextBlock" TextWrapping="Wrap"
                       Text="Выберите фильм, сеанс и место на схеме зала, затем нажмите «Продать билет»."/>
        </Border>
    </Grid>
</Window>

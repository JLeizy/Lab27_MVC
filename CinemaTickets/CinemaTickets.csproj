<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Файл проекта: описывает, ЧТО собираем и КАК.
    Это стандартный проект "WPF App (.NET)" из Visual Studio, как в методичке.
  -->
  <PropertyGroup>
    <!-- WinExe — оконное приложение (без чёрного окна консоли). -->
    <OutputType>WinExe</OutputType>

    <!-- WPF работает только под Windows, поэтому платформа "...-windows".

         Версию .NET не пишем числом (net8.0, net10.0 ...), а берём ту, что
         установлена вместе с Visual Studio. Свойство BundledNETCoreAppTargetFrameworkVersion
         задаёт сам .NET SDK: например, "8.0" в VS 2022 или "10.0" в VS 2026.

         Зачем: файлы для сборки под "свою" версию уже лежат внутри SDK, поэтому
         ничего не нужно докачивать из интернета. Если указать другую версию,
         Visual Studio пытается скачать недостающие файлы с nuget.org, и без доступа
         к нему сборка падает с ошибкой NU1301. -->
    <TargetFramework>net$(BundledNETCoreAppTargetFrameworkVersion)-windows</TargetFramework>

    <!-- Подключаем библиотеки WPF (Window, Button, TextBox и т.д.). -->
    <UseWPF>true</UseWPF>

    <!-- Как в шаблоне Visual Studio: предупреждения о возможных null
         и автоматические using для System, System.Linq и т.п. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <RootNamespace>CinemaTickets</RootNamespace>
    <AssemblyName>CinemaTickets</AssemblyName>

    <!-- Если готовую программу запустят на компьютере, где стоит только более
         новая версия .NET, она запустится на ней, а не выдаст ошибку. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

</Project>
